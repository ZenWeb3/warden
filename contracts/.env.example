# ── BOT Chain testnet ──────────────────────────────────────────────
# Deployer/owner key. Fund it from https://faucet.botchain.ai/basic
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# RPC (override if you have a faster endpoint)
BOT_RPC=https://rpc.bohr.life

# Optional: separate session-key address for the agent (defaults to deployer)
AGENT_ADDRESS=

# Filled in AFTER you run `npm run deploy`
GUARD_ADDRESS=
ALLOWED_DEST=

# Optional tuning for scripts/screen.ts
AMOUNT=0.6
SLIPPAGE_BPS=40
